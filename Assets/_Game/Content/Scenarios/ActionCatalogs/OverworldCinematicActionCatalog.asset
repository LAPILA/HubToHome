  m_Name: OverworldCinematicActionCatalog
  m_EditorClassIdentifier: Assembly-CSharp::ActionCatalogAsset
  CatalogId: overworld.cinematic
  Entries:
  - ActionId: flow.wait
    Category: flow
    DisplayNameKo: "\uB300\uAE30"
    DescriptionKo: "\uC815\uD574\uC9C4 \uC2DC\uAC04\uB9CC\uD07C \uC2DC\uD000\uC2A4\uB97C
      \uB300\uAE30\uD569\uB2C8\uB2E4."
    RuntimeAdapterId: FlowWaitActionAdapter
    Parameters:
    - Name: duration
      Type: float
      DisplayNameKo: "\uC2DC\uAC04"
      DescriptionKo: "\uCD08 \uB2E8\uC704 \uB300\uAE30 \uC2DC\uAC04"
      Required: 1
      DefaultValue: 
    ExampleYaml: "- action: flow.wait\n  params: { duration: 1.0 }"
    Disabled: 0
  - ActionId: screen.fade
    Category: presentation
    DisplayNameKo: "\uD654\uBA74 \uD398\uC774\uB4DC"
    DescriptionKo: "\uC804\uC5ED \uD654\uBA74 \uC804\uD658 \uC624\uBC84\uB808\uC774\uB97C
      \uD398\uC774\uB4DC\uD569\uB2C8\uB2E4."
    RuntimeAdapterId: ScreenFadeActionAdapter
    Parameters:
    - Name: mode
      Type: string
      DisplayNameKo: "\uBC29\uD5A5"
      DescriptionKo: "out \uB610\uB294 in"
      Required: 1
      DefaultValue: 
    - Name: color
      Type: string
      DisplayNameKo: "\uC0C9\uC0C1"
      DescriptionKo: "black, white \uB610\uB294 HTML \uC0C9\uC0C1"
      Required: 0
      DefaultValue: 
    - Name: duration
      Type: float
      DisplayNameKo: "\uC2DC\uAC04"
      DescriptionKo: "\uCD08 \uB2E8\uC704 \uD398\uC774\uB4DC \uC2DC\uAC04"
      Required: 1
      DefaultValue: 
    ExampleYaml: "- action: screen.fade\n  params: { mode: out, color: black, duration:
      0.5 }"
    Disabled: 0
  - ActionId: cinematic.stage.prepare
    Category: cinematic
    DisplayNameKo: "\uC2DC\uB124\uB9C8\uD2F1 \uC2A4\uD14C\uC774\uC9C0 \uC900\uBE44"
    DescriptionKo: "\uC52C \uACF5\uAC1C \uC804\uC5D0 \uC804\uC6A9 \uCE74\uBA54\uB77C\uC640
      \uB300\uC0C1\uC758 \uC2DC\uC791 \uC0C1\uD0DC\uB97C \uC900\uBE44\uD569\uB2C8\uB2E4."
    RuntimeAdapterId: CinematicStagePrepareActionAdapter
    Parameters:
    - Name: stage
      Type: id
      DisplayNameKo: "\uC2A4\uD14C\uC774\uC9C0"
      DescriptionKo: Cinematic Stage ID
      Required: 1
      DefaultValue: 
    - Name: shot
      Type: id
      DisplayNameKo: "\uC0F7"
      DescriptionKo: Cinematic Shot ID
      Required: 1
      DefaultValue: 
    ExampleYaml: "- action: cinematic.stage.prepare\n  params: { stage: overworld.subway_intro,
      shot: subway_arrival }"
    Disabled: 0
  - ActionId: cinematic.shot.play
    Category: cinematic
    DisplayNameKo: "\uC2DC\uB124\uB9C8\uD2F1 \uC0F7 \uC7AC\uC0DD"
    DescriptionKo: "\uC804\uC6A9 \uCE74\uBA54\uB77C \uB808\uC77C\uACFC \uC5EC\uB7EC
      \uB300\uC0C1 \uBAA8\uC158\uC744 \uB3D9\uC2DC\uC5D0 \uC7AC\uC0DD\uD569\uB2C8\uB2E4."
    RuntimeAdapterId: CinematicShotPlayActionAdapter
    Parameters:
    - Name: stage
      Type: id
      DisplayNameKo: "\uC2A4\uD14C\uC774\uC9C0"
      DescriptionKo: Cinematic Stage ID
      Required: 1
      DefaultValue: 
    - Name: shot
      Type: id
      DisplayNameKo: "\uC0F7"
      DescriptionKo: Cinematic Shot ID
      Required: 1
      DefaultValue: 
    ExampleYaml: "- action: cinematic.shot.play\n  params: { stage: overworld.subway_intro,
      shot: subway_arrival }"
    Disabled: 0
  - ActionId: cinematic.stage.release
    Category: cinematic
    DisplayNameKo: "\uC2DC\uB124\uB9C8\uD2F1 \uC2A4\uD14C\uC774\uC9C0 \uD574\uC81C"
    DescriptionKo: "\uC804\uC6A9 \uCE74\uBA54\uB77C\uB97C \uB044\uACE0 \uAE30\uBCF8
      \uAC8C\uC784 \uCE74\uBA54\uB77C\uB85C \uBCF5\uADC0\uD569\uB2C8\uB2E4."
    RuntimeAdapterId: CinematicStageReleaseActionAdapter
    Parameters:
    - Name: stage
      Type: id
      DisplayNameKo: "\uC2A4\uD14C\uC774\uC9C0"
      DescriptionKo: Cinematic Stage ID
      Required: 1
      DefaultValue: 
