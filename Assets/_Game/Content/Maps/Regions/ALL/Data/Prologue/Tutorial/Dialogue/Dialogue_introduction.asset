  Nodes:
  - Speaker: {fileID: 11400000, guid: 2adb13736db938843b32db138de9621b, type: 2}
    Emotion: 1
    LocalizationKey: HTH_PROLOGUE_DLG_INTRODUCTION_01
    DefaultText: "\uC704\uC824. \uC7A0\uAE50 \uAD1C\uCC2E\uACA0\uB098? \uBC16\uC774
      \uC774\uB798\uC11C \uC55E\uC774 \uC601 \uC548 \uBCF4\uC774\uB294\uAD70."
    EventTriggerID:
    IsChoiceNode: 0
    Choices: []
  - Speaker: {fileID: 11400000, guid: e9039ccba49340b40ae6acf24f03d6cd, type: 2}
    Emotion: 1
    LocalizationKey: HTH_PROLOGUE_DLG_INTRODUCTION_02
    DefaultText: "\uB124. \uAE30\uACC4 \uCABD\uC740 \uAD1C\uCC2E\uC544\uC694?"
    EventTriggerID:
    IsChoiceNode: 0
    Choices: []
  - Speaker: {fileID: 11400000, guid: 2adb13736db938843b32db138de9621b, type: 2}
    Emotion: 1
    LocalizationKey: HTH_PROLOGUE_DLG_INTRODUCTION_03
    DefaultText: "\uBCF4\uC870 \uB3D9\uB825 \uC7A5\uCE58\uAC00 \uC790\uAFB8 \uB5A8\uB824.
      \uC6B4\uC804\uC11D\uC744 \uBE44\uC6B8 \uC218 \uC5C6\uC5B4\uC11C\u2026 \uB124\uAC00
      \uBD10 \uC8FC\uACA0\uB098?"
    EventTriggerID:
    IsChoiceNode: 0
    Choices: []
  - Speaker: {fileID: 11400000, guid: e9039ccba49340b40ae6acf24f03d6cd, type: 2}
    Emotion: 1
    LocalizationKey: HTH_PROLOGUE_DLG_INTRODUCTION_04
    DefaultText: "\uD655\uC778\uD574 \uBCFC\uAC8C\uC694. \uC555\uB825\uBD80\uD130
      \uC0B4\uD3B4\uBCF4\uBA74 \uB418\uACA0\uB124\uC694."
    EventTriggerID:
    IsChoiceNode: 0
    Choices: []
  - Speaker: {fileID: 11400000, guid: 2adb13736db938843b32db138de9621b, type: 2}
    Emotion: 1
    LocalizationKey: HTH_PROLOGUE_DLG_INTRODUCTION_05
    DefaultText: "\uACE0\uB9D9\uB2E4. \uB05D\uB098\uBA74 \uC624\uB978\uCABD \uACF5\uC6A9\uCE78\uC5D0\uC11C
      \uC26C\uC5B4. \uB09C \uAE30\uAD00\uC2E4\uB85C \uB3CC\uC544\uAC00\uACA0\uB124."
    EventTriggerID:
    IsChoiceNode: 0
    Choices: []
