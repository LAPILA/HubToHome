  Style: 1
  Nodes:
  - Speaker: {fileID: 11400000, guid: 2e43b565b4b937d42bd80c85eb983cae, type: 2}
    Emotion: 1
    LocalizationKey: lab.bunny_slime.opening_b.00
    DefaultText: "\uC7A0\uAE50, \uBC29\uAE08\uC740 \uD558\uB098\uB3C4 \uC548 \uC544\uD320\uB294\uB370\uC694?"
    EventTriggerID: 
    IsChoiceNode: 0
    Choices: []
  - Speaker: {fileID: 11400000, guid: 841e54257c82dc04d8ec10ac181c249c, type: 2}
    Emotion: 1
    LocalizationKey: lab.bunny_slime.opening_b.01
    DefaultText: "\uC2DC\uBC94\uC6A9 \uACE0\uBB34 \uB3C4\uC7A5\uC774\uAC70\uB4E0\uC694.
      \uC774\uC81C \uC9C4\uC9DC\uB85C \uAC11\uB2C8\uB2E4."
    EventTriggerID: 
    IsChoiceNode: 0
    Choices: []
  - Speaker: {fileID: 11400000, guid: 841e54257c82dc04d8ec10ac181c249c, type: 2}
    Emotion: 1
    LocalizationKey: lab.bunny_slime.opening_b.02
    DefaultText: "\uCCAB \uC2DC\uD5D8\uC740 \uAC00\uB4DC\uC785\uB2C8\uB2E4. \uB204\uB974\uACE0
      \uBC84\uD2F0\uAC70\uB098, \uB2FF\uAE30 \uC9C1\uC804\uC5D0 \uC815\uD655\uD788
      \uB20C\uB7EC \uBCF4\uC138\uC694."
    EventTriggerID: 
    IsChoiceNode: 0
    Choices: []
  - Speaker: {fileID: 11400000, guid: 2e43b565b4b937d42bd80c85eb983cae, type: 2}
    Emotion: 1
    LocalizationKey: lab.bunny_slime.opening_b.03
    DefaultText: "\uC124\uBA85 \uB05D\uB098\uAE30 \uC804\uC5D0 \uCE58\uC2DC\uBA74
      \uC2E4\uACA9\uC785\uB2C8\uB2E4. \uC2DC\uD5D8\uAD00\uC774\uC694."
    EventTriggerID: 
    IsChoiceNode: 0
    Choices: []
