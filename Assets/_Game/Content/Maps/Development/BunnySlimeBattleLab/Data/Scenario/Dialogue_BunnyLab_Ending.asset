    Emotion: 1
    LocalizationKey: lab.bunny_slime.ending.00
    DefaultText: "\uD569\uACA9\uC785\uB2C8\uB2E4! \uB9C8\uC9C0\uB9C9 \uB3C4\uC7A5\uC740
