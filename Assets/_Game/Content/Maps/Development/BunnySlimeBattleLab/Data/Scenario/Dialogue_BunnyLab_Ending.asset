  - Speaker: {fileID: 11400000, guid: 841e54257c82dc04d8ec10ac181c249c, type: 2}
    Emotion: 1
    LocalizationKey: lab.bunny_slime.ending.02
    DefaultText: "\uBCF5\uC6D0\uB825\uB3C4 \uC778\uC99D\uBC1B\uC558\uC2B5\uB2C8\uB2E4.
      \uC7A0\uAE50\uB9CC \uB9D0\uB9AC\uBA74 \uB429\uB2C8\uB2E4."
