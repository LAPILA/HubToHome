  - Speaker: {fileID: 11400000, guid: 2e43b565b4b937d42bd80c85eb983cae, type: 2}
    Emotion: 1
    LocalizationKey: lab.bunny_slime.ending.01
    DefaultText: "\uC2DC\uD5D8\uAD00\uB2D8\uC774 \uB3C4\uC7A5\uC774 \uB41C \uAC83
