.dialogue-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    color: rgb(255, 255, 255);
}

.dialogue-panel {
    width: 100%;
    min-height: 158px;
    max-height: 236px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(22, 16, 32, 0.94);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.dialogue-window {
    flex-grow: 1;
    min-height: 0;
    position: relative;
    display: flex;
    flex-direction: column;
}

.dialogue-content {
    flex-grow: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
}

.dialogue-copy {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
}

.dialogue-portrait {
    flex-shrink: 0;
    width: 74px;
    height: 74px;
    margin-right: 10px;
    background-color: rgb(46, 39, 54);
    scale-mode: scale-to-fit;
}

.dialogue-speaker {
    flex-shrink: 0;
    height: 32px;
    margin-bottom: 4px;
    color: rgb(255, 244, 125);
    font-size: 24px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dialogue-body {
    flex-grow: 1;
    min-height: 62px;
    color: rgb(255, 255, 255);
    font-size: 22px;
    line-height: 26px;
    white-space: normal;
    -unity-text-align: upper-left;
    -unity-text-generator: advanced;
    overflow: hidden;
}

.dialogue-continue {
    position: absolute;
    right: 2px;
    bottom: 0;
    width: 18px;
    height: 20px;
    color: rgb(255, 244, 125);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.dialogue-choices {
    flex-shrink: 0;
    width: 100%;
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.dialogue-choice {
    min-height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dialogue-choice--selected {
    color: rgb(255, 242, 77);
}

.dialogue-hidden {
    display: none;
}

.dialogue-faded {
    opacity: 0;
}
